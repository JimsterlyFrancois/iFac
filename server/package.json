{
  "name": "ifac-server",
  "version": "1.0.0",
  "type": "module",
  "description": "iFac - University Document Management System Backend",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "nodemon server/index.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "rm -rf data/ifac.db && npm run db:seed",
    "lint": "echo \"Lint not configured yet\"",
    "security:audit": "npm audit",
    "clean": "rm -rf node_modules package-lock.json"
  },
  "keywords": [
    "document",
    "management",
    "university",
    "ifac"
  ],
  "author": "JimsterlyFrancois",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.1.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.3.1",
    "express-async-errors": "^3.1.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
