{
  "name": "ifac",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "iFac - Plateforme universitaire de gestion de documents",
  "scripts": {
    "start": "NODE_ENV=production node server/index.js",
    "dev": "nodemon server/index.js",
    "client": "cd client && npm run dev",
    "build": "cd client && npm run build",
    "db:migrate": "node scripts/migrate.js",
    "db:seed": "node scripts/seed.js",
    "db:reset": "node scripts/migrate.js && node scripts/seed.js",
    "test": "jest --runInBand",
    "lint": "eslint \"**/*.js\"",
    "clean": "rm -rf node_modules package-lock.json"
  },
  "dependencies": {
    "express": "^4.18.2",
    "sqlite3": "^5.1.6",
    "pg": "^8.11.3",
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "cors": "^2.8.5",
    "helmet": "^7.1.0",
    "multer": "^1.4.5-lts.1",
    "dotenv": "^16.3.1",
    "express-async-errors": "^3.1.1",
    "express-rate-limit": "^7.1.5"
  },
  "devDependencies": {
    "nodemon": "^3.0.2",
    "jest": "^29.7.0",
    "supertest": "^6.3.4",
    "eslint": "^8.57.0"
  }
}
