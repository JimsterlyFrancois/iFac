# =========================
# SERVER CONFIG
# =========================
PORT=5000
NODE_ENV=development

# =========================
# DATABASE
# =========================
DB_TYPE=sqlite
DB_PATH=./data/ifac.db

# =========================
# AUTHENTICATION (JWT)
# =========================
JWT_SECRET=change_this_to_a_very_secure_random_string_32+chars
JWT_EXPIRATION=7d
ADMIN_EMAIL=jimsterlyfrancois@gmail.com

# =========================
# FILE STORAGE
# =========================
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=52428800

# =========================
# CLIENT APP
# =========================
CLIENT_URL=http://localhost:3000

# =========================
# SECURITY (FUTURE USE)
# =========================
BCRYPT_SALT_ROUNDS=10
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
AUTH_RATE_LIMIT_MAX=20
